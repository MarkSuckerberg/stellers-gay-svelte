{
	"name": "stellers-gay-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"deploy": "vite build && wrangler deploy",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/enhanced-img": "^0.10.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.3",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-image-toolkit": "^1.0.10",
		"rehype-slug": "^6.0.0",
		"rehype-toc": "^3.0.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^7.3.6",
		"wrangler": "^4.142.0"
	},
	"dependencies": {
		"@atproto/api": "^0.21.0",
		"openmeteo": "^1.2.3"
	}
}
